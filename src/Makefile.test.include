test_test_digibyte_CPPFLAGS = $(AM_CPPFLAGS) $(DIGIBYTE_INCLUDES) $(TESTDEFS) $(BOOST_CPPFLAGS) $(EVENT_CFLAGS)
test_test_digibyte_LDADD = $(LIBTEST_UTIL)
if ENABLE_WALLET
test_test_digibyte_LDADD += $(LIBDIGIBYTE_WALLET)
test_test_digibyte_CPPFLAGS += $(BDB_CPPFLAGS)
endif

test_test_digibyte_LDADD += $(LIBDIGIBYTE_NODE) $(LIBDIGIBYTE_CLI) $(LIBDIGIBYTE_COMMON) $(LIBDIGIBYTE_UTIL) $(LIBDIGIBYTE_CONSENSUS) $(LIBDIGIBYTE_CRYPTO) $(LIBUNIVALUE) \
  $(LIBLEVELDB) $(LIBMEMENV) $(LIBSECP256K1) $(EVENT_LIBS) $(EVENT_PTHREADS_LIBS) $(MINISKETCH_LIBS)
