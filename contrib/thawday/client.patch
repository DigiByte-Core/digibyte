+++ b/src/util/thawday_lab.h
@@ -0,0 +1,30 @@
+// This file belongs only to the isolated Thaw Day rehearsal client.
+#ifndef DIGIBYTE_UTIL_THAWDAY_LAB_H
+#define DIGIBYTE_UTIL_THAWDAY_LAB_H
+
+#include <util/strencodings.h>
+
+#include <cstdlib>
+#include <stdexcept>
+#include <string>
+
+inline std::string ThawDayLabFeedURL()
+{
+    const char* enabled = std::getenv("THAWDAY_LAB");
+    if (!enabled || std::string{enabled} != "1") {
+        throw std::runtime_error("THAW DAY TEST CLIENT: set THAWDAY_LAB=1. This client is not for real funds.");
+    }
+
+    const char* configured = std::getenv("THAWDAY_FEED_URL");
+    const std::string url = configured ? configured : "";
+    const std::string prefix = "http://127.0.0.1:";
+    uint16_t port{0};
+    const std::string port_text = url.compare(0, prefix.size(), prefix) == 0 ? url.substr(prefix.size()) : "";
+    if (port_text.empty() || port_text.find_first_not_of("0123456789") != std::string::npos ||
+        !ParseUInt16(port_text, &port) || port == 0) {
+        throw std::runtime_error("THAW DAY TEST CLIENT: THAWDAY_FEED_URL must be http://127.0.0.1:<port>. Public exchange access is disabled.");
+    }
+    return url;
+}
+
+#endif // DIGIBYTE_UTIL_THAWDAY_LAB_H
